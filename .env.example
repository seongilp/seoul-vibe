# 서울 열린데이터광장 인증키
#   발급: https://data.seoul.go.kr/together/mypage/actKeyMain.do (무료, 즉시 발급)
#   비워두면 'sample' 키로 동작하며 '광화문·덕수궁' 한 곳만 조회된다.
#
# 서버 라우트에서만 읽으므로 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
SEOUL_API_KEY=

# 예비 키(선택). 주 키가 일일 트래픽을 초과(ERROR-337)하거나 무효(INFO-100)일 때만
# 자동으로 넘어간다. 매 호출 번갈아 쓰지는 않는다 — 키가 URL 경로에 들어가서
# 호출마다 키를 바꾸면 fetch 캐시가 전부 미스나고 오히려 호출량이 늘어난다.
SEOUL_API_KEY_2=
