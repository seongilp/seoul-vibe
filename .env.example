# 서울 열린데이터광장 인증키
#   발급: https://data.seoul.go.kr/together/mypage/actKeyMain.do (무료, 즉시 발급)
#   비워두면 'sample' 키로 동작하며 '광화문·덕수궁' 한 곳만 조회된다.
#
# 서버 라우트에서만 읽으므로 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
SEOUL_API_KEY=

# 예비 키(선택). 주 키가 일일 트래픽을 초과(ERROR-337)하거나 무효(INFO-100)일 때만
# 자동으로 넘어간다. 매 호출 번갈아 쓰지는 않는다 — 키가 URL 경로에 들어가서
# 호출마다 키를 바꾸면 fetch 캐시가 전부 미스나고 오히려 호출량이 늘어난다.
SEOUL_API_KEY_2=

# ── stale 캐시 L2 (Neon Postgres, 선택) ────────────────────────────────
# 인스턴스 간 공유·콜드 생존용 영구 stale 저장소. Vercel 의 Neon 통합이 자동 주입하므로
# 로컬 개발에서 L2 까지 켜려는 게 아니면 비워 둬도 된다 — 비어 있으면 메모리(L1)만으로
# 동작하고, 업스트림 정상이면 화면도 정상이다(getSql 이 없거나 잘못된 값을 안전히 무시한다).
DATABASE_URL=

# L2 튜닝(선택, 기본값 있음).
#   SEOUL_DB_READ_TIMEOUT_MS       DB 읽기 마감시한(기본 2500). 폴백 경로만 늦추므로 짧게 끊는다.
#   SEOUL_PPLTN_STALE_MAX_AGE_MS   목록 stale 최대 나이(기본 3600000=60분).
#   SEOUL_CITYDATA_STALE_MAX_AGE_MS 상세 stale 최대 나이(기본 10800000=3시간).
SEOUL_DB_READ_TIMEOUT_MS=
SEOUL_PPLTN_STALE_MAX_AGE_MS=
SEOUL_CITYDATA_STALE_MAX_AGE_MS=
